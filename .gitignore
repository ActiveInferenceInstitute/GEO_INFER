# Audit output
scripts/audit_results.txt
/.hypothesis
config/

# PLACE UnifiedBackend runtime region caches. Written next to the CWD (root
# /cache/) or under the PLACE location tree when a demo runs with
# enable_caching; regenerated on demand, never published.
/cache/
GEO-INFER-PLACE/locations/cascadia/generated/cache/region_cache_*.json
GEO-INFER-PLACE/locations/cascadia/output/data/cache/region_cache_*.json

# GitNexus local knowledge-graph index (created by `gitnexus analyze`).
/.gitnexus/

# Coverage measurement artifacts (TEST-03)
/.coverage
/.coverage.*
.gitnexus/
.claude/
mlruns/

# pytest-html test outputs
GEO-INFER-NORMS/tests/test-outputs/

# GS-023: packaged resource configs under src/ are shipped wheel content,
# not runtime output — re-include them despite the blanket config/ rule.
!GEO-INFER-*/src/**/config/
!GEO-INFER-*/src/**/config/**

# ...but packaged-resource config dirs must still exclude bytecode caches
# (the re-include above overrides the global pycache rules for those trees).
GEO-INFER-*/src/**/config/__pycache__/
GEO-INFER-*/src/**/config/**/*.pyc

# Runtime logs and machine-specific generated config never ship.
# INTRA realms probe receipts are curated exceptions referenced by docs.
*.log
!GEO-INFER-INTRA/docs/realms/outputs/**/*.log
GEO-INFER-PLACE/locations/cascadia/config/data_cleanup_config.json

# Regenerate ACT audit artifacts with verify_comprehensive.py; never track output.
/GEO-INFER-ACT/examples/output/
