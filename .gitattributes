# Bind receipt hashes to the same lock bytes on POSIX and Windows checkouts.
/uv.lock text eol=lf

# Keep the original notice and module copies byte-identical across checkouts.
/LICENSE -text -whitespace
/GEO-INFER-SPACE/LICENSE -text -whitespace
/GEO-INFER-TIME/LICENSE -text -whitespace

/GEO-INFER-ACT/examples/cascadia/data/model_pairs_20261013.zip -text
/GEO-INFER-ACT/examples/cascadia/data/model_pairs_20261013.html text eol=lf
/GEO-INFER-ACT/examples/cascadia/data/model_pairs_20261013.svg text eol=lf
/GEO-INFER-ACT/src/geo_infer_act/runners/model_pair_explorer.html text eol=lf
/GEO-INFER-ACT/examples/cascadia/data/model_matrix_20261014.zip -text
/GEO-INFER-ACT/examples/cascadia/data/model_matrix_20261014.html text eol=lf
/GEO-INFER-ACT/examples/cascadia/data/model_matrix_20261014.svg text eol=lf

# Preserve captured publisher bytes used by regional source SHA-256 contracts.
/GEO-INFER-PLACE/locations/cascadia/config/cascadia_volcanoes.source.json -text
/GEO-INFER-PLACE/locations/cascadia/config/cascadia_watersheds.source.json -text
/GEO-INFER-PLACE/locations/cascadia/config/cascadia_tectonics.source.json -text
/GEO-INFER-PLACE/locations/cascadia/config/cascadia_tectonics.metadata.xml -text

# Exact offline replay emits these normalized layer bytes with LF endings.
/GEO-INFER-PLACE/locations/cascadia/config/cascadia_volcanoes.geojson text eol=lf
/GEO-INFER-PLACE/locations/cascadia/config/cascadia_major_watersheds.geojson text eol=lf
/GEO-INFER-PLACE/locations/cascadia/config/cascadia_subduction_zone.geojson text eol=lf

# Keep the full boundary publisher snapshots and replay custody portable.
# Publisher CRLF and trailing spaces are hashed source bytes, not formatting.
/GEO-INFER-PLACE/locations/cascadia/config/cascadia_boundary*.source.json -text -whitespace
/GEO-INFER-PLACE/locations/cascadia/config/cascadia_bioregion_boundary.geojson text eol=lf
/GEO-INFER-PLACE/locations/cascadia/config/cascadia_boundary.license.md text eol=lf
/GEO-INFER-PLACE/locations/cascadia/config/cascadia_boundary.provenance.json text eol=lf
/GEO-INFER-PLACE/src/geo_infer_place/locations/cascadia/config/cascadia_boundary*.source.json -text -whitespace
/GEO-INFER-PLACE/src/geo_infer_place/locations/cascadia/config/cascadia_bioregion_boundary.geojson text eol=lf
/GEO-INFER-PLACE/src/geo_infer_place/locations/cascadia/config/cascadia_boundary.license.md text eol=lf
/GEO-INFER-PLACE/src/geo_infer_place/locations/cascadia/config/cascadia_boundary.provenance.json text eol=lf

# Reproducible packaged agent guidance; inner text is normalized UTF-8/LF.
/GEO-INFER-API/src/geo_infer_api/agent_skills.json text eol=lf
